ARG JAVA_RUNTIME_IMAGE
FROM ${JAVA_RUNTIME_IMAGE} AS notice-files
COPY notices/ /notices/
RUN find /notices -type d -exec chmod 0555 {} + \
    && find /notices -type f -exec chmod 0444 {} +

FROM ${JAVA_RUNTIME_IMAGE}
ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    SPRING_DATASOURCE_URL=jdbc:sqlite:/var/lib/lexiflow/lexicon.db?mode=ro
LABEL io.lexiflow.image-role="runtime" \
      org.opencontainers.image.title="LexiFlow" \
      org.opencontainers.image.description="Single-container LexiFlow Java 25 API and SQLite runtime"
WORKDIR /app
RUN test -x /bin/bash && test -x /usr/bin/timeout && test -x /usr/bin/env \
    && test -x /opt/java/openjdk/bin/java \
    && ! getent passwd 10001 >/dev/null \
    && useradd --uid 10001 --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin lexiflow \
    && install -d -o 10001 -g 10001 -m 0700 /var/lib/lexiflow /run/lexiflow \
    && install -d -o 10001 -g 10001 -m 0555 /app/notices
COPY --chown=10001:10001 --chmod=0444 lexiflow-api.jar /app/lexiflow-api.jar
COPY --chown=10001:10001 --chmod=0444 dataset.zip /app/dataset.zip
COPY --chown=10001:10001 --chmod=0444 release-identity.json /app/release-identity.json
COPY --chown=10001:10001 --chmod=0444 release-identity.env /app/release-identity.env
COPY --chown=10001:10001 --chmod=0555 runtime-entrypoint.sh /app/runtime-entrypoint.sh
COPY --from=notice-files --chown=10001:10001 /notices/ /app/notices/
RUN test -s /app/lexiflow-api.jar \
    && test -s /app/dataset.zip \
    && test -s /app/release-identity.json \
    && test -s /app/release-identity.env \
    && test -d /app/notices
USER 10001:10001
EXPOSE 8080
VOLUME ["/var/lib/lexiflow"]
VOLUME ["/run/lexiflow"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD ["/app/runtime-entrypoint.sh", "health"]
STOPSIGNAL SIGTERM
ENTRYPOINT ["/app/runtime-entrypoint.sh"]
CMD ["run"]
