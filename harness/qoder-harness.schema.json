{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lexiflow.qoder-harness.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identity", "required_context", "required_tools", "validation_commands"],
  "properties": {
    "schema_version": {"const": "lexiflow.qoder-harness.v1"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_package_id", "task_ids", "task_versions", "change_versions", "agent_profile"],
      "properties": {
        "work_package_id": {"type": "string", "minLength": 1},
        "task_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
        "task_versions": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
        "change_versions": {"type": "object", "additionalProperties": {"type": "string"}},
        "agent_profile": {"type": "string", "minLength": 1}
      }
    },
    "required_context": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "required_tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "probe_argv", "expected_output_regex", "timeout_seconds"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "probe_argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "expected_output_regex": {"type": "string", "minLength": 1},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 30}
        }
      }
    },
    "validation_commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["argv", "cwd", "timeout_seconds"],
        "properties": {
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "cwd": {"type": "string", "minLength": 1},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
        }
      }
    }
  }
}
