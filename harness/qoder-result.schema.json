{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lexiflow.qoder-work-package-result.v1",
  "type": "object",
  "required": ["schema_version", "status", "work_package_id", "task_ids", "task_versions", "change_versions", "run_id", "outcomes", "changed_files", "validation", "acceptance_evidence", "effect_checks", "risks"],
  "properties": {
    "schema_version": {"const": "lexiflow.qoder-work-package-result.v1"},
    "status": {"enum": ["PASS", "BLOCKED", "FAIL"]},
    "work_package_id": {"type": "string", "minLength": 1},
    "task_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
    "task_versions": {"type": "object"},
    "change_versions": {"type": "object"},
    "run_id": {"type": "string", "format": "uuid"},
    "outcomes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["task_id", "status", "acceptance_evidence"],
        "properties": {
          "task_id": {"type": "string"},
          "status": {"enum": ["PASS", "BLOCKED", "FAIL"]},
          "acceptance_evidence": {"type": "array"}
        }
      }
    },
    "changed_files": {"type": "array", "items": {"type": "string"}},
    "validation": {"type": "array"},
    "acceptance_evidence": {"type": "array"},
    "effect_checks": {"type": "array"},
    "risks": {"type": "array"}
  }
}
