@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam nodesep 48
skinparam ranksep 52
skinparam defaultFontName "Noto Sans CJK SC"
skinparam defaultFontSize 14
skinparam ArrowColor #475569
skinparam roundcorner 12
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam noteBackgroundColor #FFF7DB
skinparam noteBorderColor #D4B45D
skinparam sequenceMessageAlign center
title 七个业务领域分别拥有什么
top to bottom direction
package "核心领域" as core {
  component "Enrichment" as enrichment
  component "Vocabulary Profile" as vocabulary
  component "Learning" as learning
}
package "支持领域" as support {
  component "Content" as content
  component "Global Lexicon" as lexicon
  component "Semantic" as semantic
  component "Identity and Access" as identity
}
content --> enrichment : E1
lexicon --> enrichment : E2
vocabulary --> enrichment : E3
semantic --> enrichment : E4
learning --> vocabulary : E5
legend bottom
  箭头：通过公开合同提供数据或命令
  E 编号的含义见正文；不是编译依赖图
endlegend
@enduml
