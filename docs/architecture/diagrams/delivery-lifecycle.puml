@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Noto Sans CJK SC"
skinparam defaultFontSize 14
skinparam ArrowColor #475569
skinparam roundcorner 12
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam noteBackgroundColor #FFF7DB
skinparam noteBorderColor #D4B45D
skinparam sequenceMessageAlign center
title 投递确认、实际显示和点击各有事实来源
hide empty description
state "receipt-unknown" as unknown
state "received" as received
state "discarded" as discarded
state "displayed" as displayed
state "clicked" as clicked
[*] --> unknown : 发送当前 result revision
unknown --> unknown : 有效订阅重投同一 revision
unknown --> received : 客户端确认收到
received --> discarded : stale、取消或权限变化
received --> displayed : 检查通过且可见 overlay 已提交
displayed --> clicked : 用户交互与有效因果引用
discarded --> [*]
note right of received
  received 不是 displayed
  ACK 丢失不重新生成模型结果
end note
note bottom of displayed
  这是观察关系示意，不是单一数据库状态机
  observation/event 上传可重试，幂等计数
end note
@enduml
