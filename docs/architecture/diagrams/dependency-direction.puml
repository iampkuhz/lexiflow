@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam nodesep 48
skinparam ranksep 52
skinparam defaultFontName "Noto Sans CJK SC"
skinparam defaultFontSize 14
skinparam ArrowColor #475569
skinparam roundcorner 12
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam noteBackgroundColor #FFF7DB
skinparam noteBorderColor #D4B45D
skinparam sequenceMessageAlign center
title 代码依赖朝领域与公开端口收敛
top to bottom direction
package "组合根" #DBEAFE {
  component "api root" as api
  component "worker root" as worker
}
package "应用用例" #DCFCE7 {
  component "Workflow Application" as workflow
}
package "领域判断" #E0E7FF {
  component "Enrichment" as enrichment
  component "Learning" as learning
  component "Semantic" as semantic
}
package "公开端口" #F3E8FF {
  interface "Domain public ports" as contracts
}
package "具体适配器" #FEF3C7 {
  component "Platform adapters" as platform
}
api --> workflow : S1 调用用例
worker --> workflow : S2 调用后台用例
workflow --> enrichment : S3 协调提示
workflow --> learning : S4 接收行为
enrichment --> semantic : S5 请求语义证据
enrichment --> contracts : S6 读取公开事实
learning --> contracts : S7 应用公开 evidence
platform --> contracts : S8 实现端口
api --> platform : S9 显式装配
worker --> platform : S10 显式装配
legend bottom
  实线：本图标注的公开交互或依赖
  第一阶段提案；实现状态见工程审查
endlegend
@enduml
