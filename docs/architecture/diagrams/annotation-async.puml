@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam nodesep 48
skinparam ranksep 52
skinparam defaultFontName "Noto Sans CJK SC"
skinparam defaultFontSize 14
skinparam ArrowColor #475569
skinparam roundcorner 12
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam noteBackgroundColor #FFF7DB
skinparam noteBorderColor #D4B45D
skinparam sequenceMessageAlign center
title 已提交的语义工作如何形成可显示提示
hide footbox
box "客户端" #DBEAFE
participant "Extension" as ext
endbox
box "服务端公开协作" #DCFCE7
participant "Workflow" as workflow
participant "worker" as worker
participant "Semantic port" as semantic
participant "Enrichment" as enrichment
participant "Delivery" as delivery
endbox
ext -> ext : S1 立即显示英文
ext -> workflow : S2 请求当前片段提示
workflow -> workflow : S3 确认 durable work 已提交
workflow --> ext : S4 返回 fast result 与 pending
worker -> workflow : S5 取得当前 attempt 资格
worker -> semantic : S6 请求有界语境证据
semantic --> worker : S7 返回标准 outcome
worker -> enrichment : S8 重验规则并提交合法结果
enrichment -> enrichment : S9 持久保存 result revision
delivery -> enrichment : S10 通过公开合同读取结果
enrichment --> delivery : S11 返回 durable result
delivery -> ext : S12 增量投递同一 revision
ext -> ext : S13 检查 caption 与 profile 版本
ext --> delivery : S14 确认收到当前 revision
ext -> ext : S15 显示后创建 HintDisplayed
@enduml
