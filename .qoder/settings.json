{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel) && python3 \"$root/scripts/triggers/run_stop_checks.py\" --client qoder || exit 1",
            "timeout": 1860,
            "statusMessage": "LexiFlow：执行交付验证（Java / Python / 模块测试）"
          }
        ]
      }
    ]
  }
}
